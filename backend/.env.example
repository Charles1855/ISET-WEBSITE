# Copy this file to .env and fill in real values. NEVER commit .env to GitHub.

PORT=3000

# Websites allowed to call this API (comma separated, no trailing slash).
# Add your GitHub Pages URL and your local Live Server URL.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://YOUR-USERNAME.github.io

# --- SMTP settings (Gmail example) ---
# Gmail needs 2-Step Verification ON, then create an "App Password":
# Google Account > Security > 2-Step Verification > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASS=your-16-character-app-password

# Who receives the enquiries (can be the same as SMTP_USER)
MAIL_TO=your.address@gmail.com
# Shown as the sender name. The address part must be the one you log in with.
MAIL_FROM="ISET Website" <your.address@gmail.com>

# Send a thank-you email back to the visitor? (true / false)
AUTO_REPLY=false
